// Gruvppuccin Nebula: UI theme, generated by scripts/gruvppuccin/generate.ts
// from data/palettes.json. Edit roles.ts (or re-extract the palettes) instead of this file.
{
  "id": "nebula",
  "name": "Gruvppuccin Nebula",
  "kind": "dark",
  "tokens": {
    // Surfaces
    "--bg-app": "#1e1e29",
    "--bg-elev": "#151520",
    "--bg-popup": "#1e1e29",
    "--bg-floating-toolbar": "#2c2938",
    "--bg-hover": "#2c2938",
    "--bg-selected": "#312d3b",
    "--bg-selected-strong": "#423c4b",
    "--bg-current-line": "#2c2938",
    "--bg-debug-line": "#39464b",
    "--bg-backdrop": "#151520",
    "--bg-input": "#151520",

    // Lines
    "--border": "#151520",
    "--border-popup": "#312d3b",
    "--border-strong": "#423c4b",
    "--border-window": "#423c4b",
    "--control-off": "#595260",

    // Text
    "--fg-strong": "#d0d1c0",
    "--fg-emphasis": "#c5cbc5",
    "--fg": "#989194",
    "--fg-secondary": "#837d83",
    "--fg-muted": "#7c777c",
    "--fg-subtle": "#595260",
    "--fg-faint": "#423c4b",
    "--fg-gutter": "#595260",
    "--fg-icon": "#c5cbc5",

    // Accent
    "--accent": "var(--gp-accent)",
    "--link": "var(--gp-accent)",
    "--link-hover": "color-mix(in srgb, var(--gp-accent) 75%, var(--gp-text))",

    // Charts
    "--chart-series": "#ea6962",

    // Status
    "--danger": "#ea6962",
    "--warning": "#d8a657",
    "--success": "#a9b665",
    "--db-connected": "#a9b665",
    "--db-connected-ring": "#646a47",
    "--info": "#7daea3",

    // Vcs
    "--vcs-modified": "#93b284",
    "--vcs-added": "#a9b665",
    "--vcs-deleted": "#595260",
    "--vcs-untracked": "#ea6962",
    "--vcs-ignored": "#595260",
    "--vcs-conflict": "#ea6962",
    "--gutter-modified": "#67777b",
    "--gutter-added": "#757562",
    "--gutter-deleted": "#ea6962",
    "--diff-modified": "#1f2f2a90",
    "--diff-inserted": "#2a351a50",
    "--diff-deleted": "#1f2a2090",
    "--diff-modified-stripe": "#67777b",
    "--diff-inserted-stripe": "#757562",
    "--diff-deleted-stripe": "#7c777c",
    "--diff-conflict-stripe": "#ea6962",
    "--diff-separator-wave": "var(--fg-subtle)",

    // Shadows and window controls
    "--shadow-popup": "0 6px 20px rgba(0, 0, 0, 0.45)",
    "--shadow-dialog": "0 0 0 0.5px rgba(0, 0, 0, 0.6), 0 10px 24px rgba(0, 0, 0, 0.35), 0 24px 72px rgba(0, 0, 0, 0.45)",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "#312d3b",
    "--traffic-off-border": "#2c2938",

    // Additive
    "--bg-stripe-tooltip": "var(--bg-tooltip)",
    "--fg-stripe-tooltip": "var(--fg-tooltip)",
    "--border-stripe-tooltip": "var(--border-tooltip)",
    "--shadow-stripe-tooltip": "var(--shadow-tooltip)",
    "--bg-tooltip": "#151520",
    "--fg-tooltip": "#c5cbc5",
    "--border-tooltip": "#312d3b",
    "--bg-control": "#2c2938",
    "--bg-control-hover": "#312d3b",
    "--bg-active": "#423c4b",
    "--bg-scrim": "rgba(0, 0, 0, 0.45)",
    "--fg-on-accent": "#12121d",
    "--shadow-tooltip": "0 4px 12px rgba(0, 0, 0, 0.4)",
    "--shadow-balloon": "0 8px 24px rgba(0, 0, 0, 0.45)",

    // Islands contract
    "--bg-frame": "#151520",
    "--bg-island": "#1e1e29",
    "--bg-stripe-hover": "#d0d1c017",
    "--bg-stripe-selected": "#d0d1c029",
    "--fg-stripe-selected-active": "#d0d1c0",
    "--fg-stripe-label": "#837d83",
    "--bg-tab-selected": "#181823",
    "--border-tab-selected": "var(--gp-accent-tab)",
    "--bg-tab-selected-inactive": "#151520",
    "--border-tab-selected-inactive": "#423c4b",
    "--bg-tab-hover": "#2c2938",
    "--border-editor-tabs": "#151520",
    "--bg-tree-selected": "#2c2938",
    "--bg-tree-selected-inactive": "#2c2938",
    "--bg-tree-hover": "#d0d1c00f",
    "--bg-toolbar-hover": "color-mix(in srgb, var(--gp-accent) 12%, transparent)",
    "--bg-toolbar-pressed": "color-mix(in srgb, var(--gp-accent) 22%, transparent)",
    "--bg-toolbar-selected": "color-mix(in srgb, var(--gp-accent) 28%, var(--gp-base))",
    "--bg-toolbar-selected-hover": "color-mix(in srgb, var(--gp-accent) 36%, var(--gp-base))",
    "--bg-button-primary-hover": "var(--accent-hover)",
    "--fg-button-primary": "#12121d",
    "--bg-button": "transparent",
    "--border-button": "#423c4b",
    "--bg-field": "#151520",
    "--bg-checkbox": "#151520",
    "--border-checkbox": "#595260",
    "--bg-toggle-on": "color-mix(in srgb, var(--gp-accent) 56%, transparent)",
    "--fg-toggle-on": "#d0d1c0",
    "--bg-toggle-off": "#12121d",
    "--fg-toggle-off": "var(--gp-accent)",
    "--border-toggle": "#595260",
    "--bg-toggle-knob": "#7c777c",
    "--focus-ring-soft": "color-mix(in srgb, var(--gp-accent) 45%, transparent)",
    "--scrollbar-thumb": "#59526080",
    "--scrollbar-thumb-hover": "#595260d9",
    "--bg-search-match": "#a07d49",
    "--bg-search-match-current": "#d8a657",
    "--fg-search-match": "#12121d",
    "--bg-dialog": "#1e1e29",
    "--bg-popup-inline": "#151520",
    "--bg-popup-advertiser": "#151520",
    "--bg-feedback-info": "#2b323a",
    "--border-feedback-info": "#3f5054",
    "--bg-feedback-error": "#3b2931",
    "--border-feedback-error": "#65383d",
    "--bg-feedback-warning": "#38312f",
    "--border-feedback-warning": "#5f4e39",
    "--bg-feedback-success": "#313331",
    "--border-feedback-success": "#4f533e",
    "--bg-counter": "color-mix(in srgb, var(--gp-accent) 38%, transparent)",
    "--fg-counter": "#d0d1c0",
    "--bg-progress-track": "#312d3b",

    // Gruvppuccin palette and accent slots
    "--gp-sapphire": "#7daea3",
    "--gp-mauve": "#c28fd6",
    "--gp-red": "#ea6962",
    "--gp-green": "#a9b665",
    "--gp-yellow": "#d8a657",
    "--gp-peach": "#e78a4e",
    "--gp-crust": "#12121d",
    "--gp-mantle": "#151520",
    "--gp-base": "#1e1e29",
    "--gp-surface0": "#2c2938",
    "--gp-surface1": "#312d3b",
    "--gp-surface2": "#423c4b",
    "--gp-overlay0": "#595260",
    "--gp-overlay1": "#7c777c",
    "--gp-overlay2": "#837d83",
    "--gp-subtext0": "#989194",
    "--gp-subtext1": "#c5cbc5",
    "--gp-text": "#d0d1c0",
    "--gp-accent": "var(--gp-sapphire)",
    "--gp-accent-tab": "var(--gp-accent)",
    "--gp-accent-toolwindow": "var(--gp-accent)",
    "--gp-accent-caret": "var(--gp-accent)",

    // Classic style: hairline borders instead of islands
    "--island-gap": "1px",
    "--island-radius": "0px"
  }
}
