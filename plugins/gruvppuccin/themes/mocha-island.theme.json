// Gruvppuccin Mocha Island: UI theme, generated by scripts/gruvppuccin/generate.ts
// from data/palettes.json. Edit roles.ts (or re-extract the palettes) instead of this file.
{
  "id": "mocha-island",
  "name": "Gruvppuccin Mocha Island",
  "kind": "dark",
  "tokens": {
    // Surfaces
    "--bg-app": "#1d2021",
    "--bg-elev": "#191b1c",
    "--bg-popup": "#1d2021",
    "--bg-floating-toolbar": "#282828",
    "--bg-hover": "#282828",
    "--bg-selected": "#32302f",
    "--bg-selected-strong": "#45403d",
    "--bg-current-line": "#282828",
    "--bg-debug-line": "#384845",
    "--bg-backdrop": "#191b1c",
    "--bg-input": "#191b1c",

    // Lines
    "--border": "#191b1c",
    "--border-popup": "#32302f",
    "--border-strong": "#45403d",
    "--border-window": "#45403d",
    "--control-off": "#5a524c",

    // Text
    "--fg-strong": "#d4be98",
    "--fg-emphasis": "#bfb3a2",
    "--fg": "#a69a8a",
    "--fg-secondary": "#7c7269",
    "--fg-muted": "#6e655a",
    "--fg-subtle": "#5a524c",
    "--fg-faint": "#45403d",
    "--fg-gutter": "#5a524c",
    "--fg-icon": "#bfb3a2",

    // Accent
    "--accent": "var(--gp-accent)",
    "--link": "var(--gp-accent)",
    "--link-hover": "color-mix(in srgb, var(--gp-accent) 75%, var(--gp-text))",

    // Charts
    "--chart-series": "#ea6962",

    // Status
    "--danger": "#ea6962",
    "--warning": "#d8a657",
    "--success": "#a9b665",
    "--db-connected": "#a9b665",
    "--db-connected-ring": "#636b43",
    "--info": "#7daea3",

    // Vcs
    "--vcs-modified": "#89b482",
    "--vcs-added": "#a9b665",
    "--vcs-deleted": "#5a524c",
    "--vcs-untracked": "#ea6962",
    "--vcs-ignored": "#5a524c",
    "--vcs-conflict": "#ea6962",
    "--gutter-modified": "#456a62",
    "--gutter-added": "#506545",
    "--gutter-deleted": "#ea6962",
    "--diff-modified": "#1f2f2a90",
    "--diff-inserted": "#2a351a50",
    "--diff-deleted": "#1f2a2090",
    "--diff-modified-stripe": "#456a62",
    "--diff-inserted-stripe": "#506545",
    "--diff-deleted-stripe": "#6e655a",
    "--diff-conflict-stripe": "#ea6962",
    "--diff-separator-wave": "var(--fg-subtle)",

    // Shadows and window controls
    "--shadow-popup": "0 6px 20px rgba(0, 0, 0, 0.45)",
    "--shadow-dialog": "0 0 0 0.5px rgba(0, 0, 0, 0.6), 0 10px 24px rgba(0, 0, 0, 0.35), 0 24px 72px rgba(0, 0, 0, 0.45)",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "#32302f",
    "--traffic-off-border": "#282828",

    // Additive
    "--bg-stripe-tooltip": "var(--bg-tooltip)",
    "--fg-stripe-tooltip": "var(--fg-tooltip)",
    "--border-stripe-tooltip": "var(--border-tooltip)",
    "--shadow-stripe-tooltip": "var(--shadow-tooltip)",
    "--bg-tooltip": "#191b1c",
    "--fg-tooltip": "#bfb3a2",
    "--border-tooltip": "#32302f",
    "--bg-control": "#282828",
    "--bg-control-hover": "#32302f",
    "--bg-active": "#45403d",
    "--bg-scrim": "rgba(0, 0, 0, 0.45)",
    "--fg-on-accent": "#141617",
    "--shadow-tooltip": "0 4px 12px rgba(0, 0, 0, 0.4)",
    "--shadow-balloon": "0 8px 24px rgba(0, 0, 0, 0.45)",

    // Islands contract
    "--bg-frame": "#141617",
    "--bg-island": "#141617",
    "--bg-stripe-hover": "#d4be9817",
    "--bg-stripe-selected": "#d4be9829",
    "--fg-stripe-selected-active": "#d4be98",
    "--fg-stripe-label": "#7c7269",
    "--bg-tab-selected": "#242424",
    "--border-tab-selected": "var(--gp-accent-tab)",
    "--bg-tab-selected-inactive": "#191b1c",
    "--border-tab-selected-inactive": "#45403d",
    "--bg-tab-hover": "#282828",
    "--border-editor-tabs": "#191b1c",
    "--bg-tree-selected": "#282828",
    "--bg-tree-selected-inactive": "#282828",
    "--bg-tree-hover": "#d4be980f",
    "--bg-toolbar-hover": "color-mix(in srgb, var(--gp-accent) 12%, transparent)",
    "--bg-toolbar-pressed": "color-mix(in srgb, var(--gp-accent) 22%, transparent)",
    "--bg-toolbar-selected": "color-mix(in srgb, var(--gp-accent) 28%, var(--gp-base))",
    "--bg-toolbar-selected-hover": "color-mix(in srgb, var(--gp-accent) 36%, var(--gp-base))",
    "--bg-button-primary-hover": "var(--accent-hover)",
    "--fg-button-primary": "#141617",
    "--bg-button": "transparent",
    "--border-button": "#45403d",
    "--bg-field": "#191b1c",
    "--bg-checkbox": "#191b1c",
    "--border-checkbox": "#5a524c",
    "--bg-toggle-on": "color-mix(in srgb, var(--gp-accent) 56%, transparent)",
    "--fg-toggle-on": "#d4be98",
    "--bg-toggle-off": "#141617",
    "--fg-toggle-off": "var(--gp-accent)",
    "--border-toggle": "#5a524c",
    "--bg-toggle-knob": "#6e655a",
    "--focus-ring-soft": "color-mix(in srgb, var(--gp-accent) 45%, transparent)",
    "--scrollbar-thumb": "#5a524c80",
    "--scrollbar-thumb-hover": "#5a524cd9",
    "--bg-search-match": "#a07e47",
    "--bg-search-match-current": "#d8a657",
    "--fg-search-match": "#141617",
    "--bg-dialog": "#1d2021",
    "--bg-popup-inline": "#191b1c",
    "--bg-popup-advertiser": "#191b1c",
    "--bg-feedback-info": "#2a3433",
    "--border-feedback-info": "#3f524f",
    "--bg-feedback-error": "#3a2a2a",
    "--border-feedback-error": "#653a38",
    "--bg-feedback-warning": "#373329",
    "--border-feedback-warning": "#5e4f34",
    "--bg-feedback-success": "#31352b",
    "--border-feedback-success": "#4e5539",
    "--bg-counter": "color-mix(in srgb, var(--gp-accent) 38%, transparent)",
    "--fg-counter": "#d4be98",
    "--bg-progress-track": "#32302f",

    // Gruvppuccin palette and accent slots
    "--gp-sapphire": "#7daea3",
    "--gp-mauve": "#c28fd6",
    "--gp-red": "#ea6962",
    "--gp-green": "#a9b665",
    "--gp-yellow": "#d8a657",
    "--gp-peach": "#e78a4e",
    "--gp-crust": "#141617",
    "--gp-mantle": "#191b1c",
    "--gp-base": "#1d2021",
    "--gp-surface0": "#282828",
    "--gp-surface1": "#32302f",
    "--gp-surface2": "#45403d",
    "--gp-overlay0": "#5a524c",
    "--gp-overlay1": "#6e655a",
    "--gp-overlay2": "#7c7269",
    "--gp-subtext0": "#a69a8a",
    "--gp-subtext1": "#bfb3a2",
    "--gp-text": "#d4be98",
    "--gp-accent": "var(--gp-sapphire)",
    "--gp-accent-tab": "var(--gp-accent)",
    "--gp-accent-toolwindow": "var(--gp-accent)",
    "--gp-accent-caret": "var(--gp-accent)"
  }
}
