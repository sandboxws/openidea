// Gruvppuccin Nocturne Midnight Mocha: UI theme, generated by scripts/gruvppuccin/generate.ts
// from data/palettes.json. Edit roles.ts (or re-extract the palettes) instead of this file.
{
  "id": "nocturne-midnight-mocha",
  "name": "Gruvppuccin Nocturne Midnight Mocha",
  "kind": "dark",
  "tokens": {
    // Surfaces
    "--bg-app": "#0b0d12",
    "--bg-elev": "#090b0f",
    "--bg-popup": "#0b0d12",
    "--bg-floating-toolbar": "#12151c",
    "--bg-hover": "#12151c",
    "--bg-selected": "#1c2029",
    "--bg-selected-strong": "#2b2f3b",
    "--bg-current-line": "#12151c",
    "--bg-debug-line": "#2a3d54",
    "--bg-backdrop": "#090b0f",
    "--bg-input": "#090b0f",

    // Lines
    "--border": "#090b0f",
    "--border-popup": "#1c2029",
    "--border-strong": "#2b2f3b",
    "--border-window": "#2b2f3b",
    "--control-off": "#464c5b",

    // Text
    "--fg-strong": "#d8cbb0",
    "--fg-emphasis": "#bbb7b1",
    "--fg": "#a3a6b2",
    "--fg-secondary": "#767c8a",
    "--fg-muted": "#5e6575",
    "--fg-subtle": "#464c5b",
    "--fg-faint": "#2b2f3b",
    "--fg-gutter": "#464c5b",
    "--fg-icon": "#bbb7b1",

    // Accent
    "--accent": "var(--gp-accent)",
    "--link": "var(--gp-accent)",
    "--link-hover": "color-mix(in srgb, var(--gp-accent) 75%, var(--gp-text))",

    // Charts
    "--chart-series": "#ea6962",

    // Status
    "--danger": "#ea6962",
    "--warning": "#d8a657",
    "--success": "#a9b665",
    "--db-connected": "#a9b665",
    "--db-connected-ring": "#5a623c",
    "--info": "#79b8ff",

    // Vcs
    "--vcs-modified": "#89b482",
    "--vcs-added": "#a9b665",
    "--vcs-deleted": "#464c5b",
    "--vcs-untracked": "#ea6962",
    "--vcs-ignored": "#464c5b",
    "--vcs-conflict": "#ea6962",
    "--gutter-modified": "#5a779d",
    "--gutter-added": "#69715f",
    "--gutter-deleted": "#ea6962",
    "--diff-modified": "#1f2f2a90",
    "--diff-inserted": "#2a351a50",
    "--diff-deleted": "#1f2a2090",
    "--diff-modified-stripe": "#5a779d",
    "--diff-inserted-stripe": "#69715f",
    "--diff-deleted-stripe": "#5e6575",
    "--diff-conflict-stripe": "#ea6962",
    "--diff-separator-wave": "var(--fg-subtle)",

    // Shadows and window controls
    "--shadow-popup": "0 6px 20px rgba(0, 0, 0, 0.45)",
    "--shadow-dialog": "0 0 0 0.5px rgba(0, 0, 0, 0.6), 0 10px 24px rgba(0, 0, 0, 0.35), 0 24px 72px rgba(0, 0, 0, 0.45)",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "#1c2029",
    "--traffic-off-border": "#12151c",

    // Additive
    "--bg-stripe-tooltip": "var(--bg-tooltip)",
    "--fg-stripe-tooltip": "var(--fg-tooltip)",
    "--border-stripe-tooltip": "var(--border-tooltip)",
    "--shadow-stripe-tooltip": "var(--shadow-tooltip)",
    "--bg-tooltip": "#090b0f",
    "--fg-tooltip": "#bbb7b1",
    "--border-tooltip": "#1c2029",
    "--bg-control": "#12151c",
    "--bg-control-hover": "#1c2029",
    "--bg-active": "#2b2f3b",
    "--bg-scrim": "rgba(0, 0, 0, 0.45)",
    "--fg-on-accent": "#07080b",
    "--shadow-tooltip": "0 4px 12px rgba(0, 0, 0, 0.4)",
    "--shadow-balloon": "0 8px 24px rgba(0, 0, 0, 0.45)",

    // Islands contract
    "--bg-frame": "#090b0f",
    "--bg-island": "#0b0d12",
    "--bg-stripe-hover": "#d8cbb017",
    "--bg-stripe-selected": "#d8cbb029",
    "--fg-stripe-selected-active": "#d8cbb0",
    "--fg-stripe-label": "#767c8a",
    "--bg-tab-selected": "#0a0c10",
    "--border-tab-selected": "var(--gp-accent-tab)",
    "--bg-tab-selected-inactive": "#090b0f",
    "--border-tab-selected-inactive": "#2b2f3b",
    "--bg-tab-hover": "#12151c",
    "--border-editor-tabs": "#090b0f",
    "--bg-tree-selected": "#12151c",
    "--bg-tree-selected-inactive": "#12151c",
    "--bg-tree-hover": "#d8cbb00f",
    "--bg-toolbar-hover": "color-mix(in srgb, var(--gp-accent) 12%, transparent)",
    "--bg-toolbar-pressed": "color-mix(in srgb, var(--gp-accent) 22%, transparent)",
    "--bg-toolbar-selected": "color-mix(in srgb, var(--gp-accent) 28%, var(--gp-base))",
    "--bg-toolbar-selected-hover": "color-mix(in srgb, var(--gp-accent) 36%, var(--gp-base))",
    "--bg-button-primary-hover": "var(--accent-hover)",
    "--fg-button-primary": "#07080b",
    "--bg-button": "transparent",
    "--border-button": "#2b2f3b",
    "--bg-field": "#090b0f",
    "--bg-checkbox": "#090b0f",
    "--border-checkbox": "#464c5b",
    "--bg-toggle-on": "color-mix(in srgb, var(--gp-accent) 56%, transparent)",
    "--fg-toggle-on": "#d8cbb0",
    "--bg-toggle-off": "#07080b",
    "--fg-toggle-off": "var(--gp-accent)",
    "--border-toggle": "#464c5b",
    "--bg-toggle-knob": "#5e6575",
    "--focus-ring-soft": "color-mix(in srgb, var(--gp-accent) 45%, transparent)",
    "--scrollbar-thumb": "#464c5b80",
    "--scrollbar-thumb-hover": "#464c5bd9",
    "--bg-search-match": "#9b7842",
    "--bg-search-match-current": "#d8a657",
    "--fg-search-match": "#07080b",
    "--bg-dialog": "#0b0d12",
    "--bg-popup-inline": "#090b0f",
    "--bg-popup-advertiser": "#090b0f",
    "--bg-feedback-info": "#1a2533",
    "--border-feedback-info": "#324965",
    "--bg-feedback-error": "#2a1a1d",
    "--border-feedback-error": "#592d2e",
    "--bg-feedback-warning": "#28221c",
    "--border-feedback-warning": "#53432a",
    "--bg-feedback-success": "#21251e",
    "--border-feedback-success": "#42482f",
    "--bg-counter": "color-mix(in srgb, var(--gp-accent) 38%, transparent)",
    "--fg-counter": "#d8cbb0",
    "--bg-progress-track": "#1c2029",

    // Gruvppuccin palette and accent slots
    "--gp-sapphire": "#79b8ff",
    "--gp-mauve": "#c28fd6",
    "--gp-red": "#ea6962",
    "--gp-green": "#a9b665",
    "--gp-yellow": "#d8a657",
    "--gp-peach": "#e78a4e",
    "--gp-crust": "#07080b",
    "--gp-mantle": "#090b0f",
    "--gp-base": "#0b0d12",
    "--gp-surface0": "#12151c",
    "--gp-surface1": "#1c2029",
    "--gp-surface2": "#2b2f3b",
    "--gp-overlay0": "#464c5b",
    "--gp-overlay1": "#5e6575",
    "--gp-overlay2": "#767c8a",
    "--gp-subtext0": "#a3a6b2",
    "--gp-subtext1": "#bbb7b1",
    "--gp-text": "#d8cbb0",
    "--gp-accent": "var(--gp-sapphire)",
    "--gp-accent-tab": "var(--gp-accent)",
    "--gp-accent-toolwindow": "var(--gp-accent)",
    "--gp-accent-caret": "var(--gp-accent)",

    // Classic style: hairline borders instead of islands
    "--island-gap": "1px",
    "--island-radius": "0px"
  }
}
